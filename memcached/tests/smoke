#!/usr/bin/env bash
# RCP-232 through the Service memcached on port 11211 in memcached's text
# protocol: a value set on one connection and read on the next, stats with
# the version of the image tag, and the pod under Pod Security restricted.
set -euo pipefail
image=$(kubectl get deployment memcached -o jsonpath='{.spec.template.spec.containers[?(@.name=="memcached")].image}')
tag=${image#*:}
tag=${tag%@*}

# The image has no nc, so bash's /dev/tcp is the client. quit makes memcached
# close the connection, which ends cat.
mc() {
  kubectl exec deployment/memcached -c memcached -- \
    bash -c 'exec 3<>/dev/tcp/memcached/11211 && printf %s "$1" >&3 && timeout 5 cat <&3' mc "$1" | tr -d '\r'
}

# The Service may lag behind the pod's readiness for a moment.
for _ in $(seq 15); do
  stored=$(mc $'set smoke 0 0 4\r\nkept\r\nquit\r\n' 2>/dev/null || true)
  [[ $stored == STORED ]] && break
  sleep 2
done
[[ $stored == STORED ]] || { echo "set answered: $stored" >&2; exit 1; }
mapfile -t out <<<"$(mc $'get smoke\r\nstats\r\nquit\r\n')"
[[ ${out[0]} == 'VALUE smoke 0 4' && ${out[1]} == kept && ${out[2]} == END ]] \
  || { printf 'get answered: %s\n' "${out[@]:0:3}" >&2; exit 1; }
version=$(printf '%s\n' "${out[@]}" | sed -n 's/^STAT version //p')
[[ $version == "$tag" ]] || { echo "stats version $version, image tag $tag" >&2; exit 1; }

# PodSecurity admission warns on a dry run of the label when a running pod violates the level.
namespace=$(kubectl config view --minify -o jsonpath='{..namespace}')
warnings=$(kubectl label --dry-run=server --overwrite namespace "$namespace" \
  pod-security.kubernetes.io/enforce=restricted 2>&1 >/dev/null)
[[ -z $warnings ]] || { echo "$warnings" >&2; exit 1; }
# check reports the last line.
echo "memcached $version stored a value and returned it on a second connection through the Service memcached, and answered stats. The pod passes Pod Security restricted."
