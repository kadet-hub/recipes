#!/usr/bin/env bash
# RCP-78: once the database is ready, Semaphore answers /api/ping through the
# endpoints of its Service. The admin of semaphore-admin logs in through
# /api/auth/login, which needs the account that the init container wrote into
# PostgreSQL, and reads /api/user and /api/projects with the session cookie.
# /api/info reports the version of the image tag and remote runners off.
set -euo pipefail
kubectl wait clusters.postgresql.cnpg.io/postgresql-cluster --for=condition=Ready --timeout=600s >/dev/null
ns=$(kubectl config view --minify -o jsonpath='{..namespace}')
[[ $(kubectl get --raw "/api/v1/namespaces/$ns/services/semaphore:http/proxy/api/ping") == pong ]]
work=$(mktemp -d)
kubectl port-forward service/semaphore 13000:3000 >/dev/null &
trap 'kill $!; rm -rf "$work"' EXIT
url=http://127.0.0.1:13000/api
for _ in $(seq 30); do
  curl -fsS -o /dev/null "$url/ping" 2>/dev/null && break
  sleep 2
done
user=$(kubectl get secret semaphore-admin -o jsonpath='{.data.username}' | base64 -d)
password=$(kubectl get secret semaphore-admin -o jsonpath='{.data.password}' | base64 -d)
jq -n --arg auth "$user" --arg password "$password" '{$auth, $password}' |
  curl -fsS -c "$work/cookies" -H 'Content-Type: application/json' -d @- "$url/auth/login"
api() { curl -fsS -b "$work/cookies" "$url/$1"; }
api user | jq -e --arg user "$user" '.username == $user and .admin' >/dev/null
api projects | jq -e 'type == "array"' >/dev/null
image=$(kubectl get deployment semaphore -o jsonpath='{.spec.template.spec.containers[0].image}')
tag=${image%@*}
tag=${tag##*:}
info=$(api info)
jq -e --arg tag "$tag" '(.version | startswith($tag)) and (.use_remote_runner | not)' <<<"$info" >/dev/null || {
  echo "$info" >&2
  exit 1
}
echo "/api/ping through the Service, login as $user, /api/user admin, /api/projects, /api/info $(jq -r .version <<<"$info") without remote runners"
