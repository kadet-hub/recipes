#!/usr/bin/env bash
# RCP-420: the pod under Pod Security restricted, then from a pod of the
# gotify image through the cluster IP of the Service gotify on port 80 the
# refusal of requests without valid credentials, an application created as
# the admin, a message pushed with its token and listed, and the message
# again after gotify-0 restarted.
set -euo pipefail
# The admin of tests/target.yml.
admin=admin:smoke-password
image=$(kubectl get statefulset gotify -o jsonpath='{.spec.template.spec.containers[?(@.name=="gotify")].image}')
# The Service's cluster IP needs no name lookup, so no request can leave the
# cluster through a search domain of the node.
url=http://$(kubectl get service gotify -o jsonpath='{.spec.clusterIP}')

# PodSecurity admission warns on a dry run of the label when a running pod
# violates the level, so this runs before the test pod starts.
namespace=$(kubectl config view --minify -o jsonpath='{..namespace}')
warnings=$(kubectl label --dry-run=server --overwrite namespace "$namespace" \
  pod-security.kubernetes.io/enforce=restricted 2>&1 >/dev/null)
[[ -z $warnings ]] || { echo "$warnings" >&2; exit 1; }

# The image brings curl, so the test needs no other image.
kubectl run gotify-smoke --image="$image" --restart=Never --command -- sleep 900 >/dev/null
trap 'kubectl delete pod gotify-smoke --wait=false >/dev/null' EXIT
kubectl wait pod/gotify-smoke --for=condition=Ready --timeout=300s >/dev/null
run() { kubectl exec gotify-smoke -- "$@"; }
fail() { echo "$1" >&2; kubectl logs gotify-0 --tail=40 >&2 || true; exit 1; }
# A request's status. The body goes to /tmp/out in the test pod.
call() { run curl -sS -o /tmp/out -w '%{http_code}' "$@"; }

# The Service gets the ready pod as its endpoint a moment after the pod is
# ready. The last answer or curl error goes into the failure.
reachable() {
  local out
  for _ in $(seq 30); do
    out=$(run curl -sS "$url/health" 2>&1) && [[ $(jq -r .health <<<"$out") == green ]] && return
    sleep 2
  done
  fail "/health through the Service gotify: ${out:-no answer}"
}
# The texts of the messages the admin lists.
messages() {
  local status
  status=$(call -u "$admin" "$url/message")
  [[ $status == 200 ]] || { echo "status $status"; return; }
  jq -r '.messages[].message' <<<"$(run cat /tmp/out)"
}

reachable
status=$(call "$url/message")
[[ $status == 401 ]] || fail "/message without credentials answered $status, not 401"
status=$(call -u admin:wrong-password "$url/message")
[[ $status == 401 ]] || fail "/message with a wrong password answered $status, not 401"
status=$(call -H 'X-Gotify-Key: wrong-token' -F message=smoke "$url/message")
[[ $status == 401 ]] || fail "a message with a wrong application token answered $status, not 401"

status=$(call -u "$admin" -F name=smoke "$url/application")
[[ $status == 200 ]] || fail "creating the application as the admin answered $status, not 200"
token=$(jq -r .token <<<"$(run cat /tmp/out)")
status=$(call -H "X-Gotify-Key: $token" -F 'message=Smoke message' "$url/message")
[[ $status == 200 ]] || fail "pushing a message with the application's token answered $status, not 200"
out=$(messages)
[[ $out == "Smoke message" ]] || fail "the admin does not list the message: $out"

kubectl delete pod gotify-0 --wait >/dev/null
kubectl wait pod/gotify-0 --for=create --timeout=60s >/dev/null
kubectl wait pod/gotify-0 --for=condition=Ready --timeout=300s >/dev/null
reachable
# The message comes from gotify.db on the claim data. The admin's login does
# not show the claim: on an empty database gotify creates the admin again.
out=$(messages)
[[ $out == "Smoke message" ]] || fail "after gotify-0 restarted, the admin does not list the message: $out"
# check reports the last line.
echo "gotify answered /message with 401 without credentials, with a wrong password and with a wrong application token, let the admin create an application whose token pushed a message through the Service gotify, and after gotify-0 restarted the admin still listed it. The pod passes Pod Security restricted."
