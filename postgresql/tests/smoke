#!/usr/bin/env bash
# What the chart's left-out ping test checks, and the kadet-hub/examples
# recipe before it: the Cluster is ready and the user app reaches its
# database app through the read-write Service with the operator's Secret.
# The options pgvector and earthdistance: the extensions vector, cube and
# earthdistance exist in app, and app uses them.
set -euo pipefail
kubectl wait cluster/postgresql-cluster --for=condition=Ready --timeout=600s >/dev/null
secret() { kubectl get secret postgresql-cluster-app -o jsonpath="{.data.$1}" | base64 -d; }
[[ $(secret host) == postgresql-cluster-rw ]]
primary=$(kubectl get cluster postgresql-cluster -o jsonpath='{.status.currentPrimary}')
sql() {
  kubectl exec "$primary" -c postgres -- env PGPASSWORD="$(secret password)" \
    psql -h postgresql-cluster-rw -U "$(secret username)" -d "$(secret dbname)" -tAc "$1"
}
[[ $(sql 'select 1') == 1 ]]
version=$(sql "select extversion from pg_extension where extname = 'vector'")
[[ -n $version ]]
[[ $(sql "select '[1,2,3]'::vector <-> '[1,2,5]'::vector") == 2 ]]
[[ $(sql "select count(*) from pg_extension where extname in ('cube', 'earthdistance')") == 2 ]]
# One degree of longitude on the equator, about 111 km.
[[ $(sql "select earth_distance(ll_to_earth(0, 0), ll_to_earth(0, 1)) between 111000 and 112000") == t ]]
echo "select 1 as app in app through postgresql-cluster-rw, vector $version and earthdistance usable by app"
