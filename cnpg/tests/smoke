#!/usr/bin/env bash
# The operator serves its webhooks with the CA it wrote into them: a Cluster
# is admitted, the mutating webhook fills its defaults, and it becomes ready.
set -euo pipefail
ns=cnpg-smoke
kubectl create namespace "$ns" >/dev/null
trap 'kubectl delete namespace "$ns" --wait=false >/dev/null' EXIT
cluster() {
  kubectl -n "$ns" apply -f - <<'YAML'
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: smoke
spec:
  instances: 1
  imageName: ghcr.io/cloudnative-pg/postgresql:18.6-system-trixie@sha256:f7e00138159bb45d70b624ba25e446924cb3ed1bf366d13e936c3f81b914064e
  storage:
    size: 1Gi
YAML
}
# The operator writes the CA shortly after it is ready.
for _ in $(seq 30); do cluster >/dev/null 2>&1 && break; sleep 2; done
cluster >/dev/null
[[ $(kubectl -n "$ns" get cluster smoke -o jsonpath='{.spec.postgresUID}') == 26 ]]
kubectl -n "$ns" wait cluster/smoke --for=condition=Ready --timeout=300s >/dev/null
echo "Cluster smoke admitted, defaulted by the mutating webhook and ready"
