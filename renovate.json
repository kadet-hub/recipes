{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>kadet-hub/renovate-config"
  ],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "description": "RCP-30: tool versions marked with a renovate comment; release-asset and image pins carry their checksum along",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.yml$/",
        "/^\\.github/actions/[^/]+/action\\.yml$/",
        "check/check.py"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+: (?<currentValue>[^\"\\s:@]+)\\n",
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+: (?<currentValue>\\S+)\\n\\s*[A-Z_]+_SHA256: (?<currentDigest>[0-9a-f]{64})",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n[A-Z_]+ = \"\\S+?:(?<currentValue>[^@\"\\s:]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ]
    },
    {
      "description": "RCP-16: the chart a recipe is derived from, or a designed recipe's image, by version and digest in its README's Source line",
      "customType": "regex",
      "managerFilePatterns": [
        "/^[^/]+/README\\.md$/"
      ],
      "matchStrings": [
        "Source: `oci://(?<depName>[^:`\\s]+):(?<currentValue>[^@`\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})`",
        "Source: `(?<depName>[a-z0-9.-]+\\.[a-z]+/[^:`\\s]+):(?<currentValue>[^@`\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})`"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "RCP-16: the release manifest a recipe is derived from, by tag and SHA-256 in its README's Source line",
      "customType": "regex",
      "managerFilePatterns": [
        "/^[^/]+/README\\.md$/"
      ],
      "matchStrings": [
        "Source: `https://github\\.com/(?<depName>[^/`\\s]+/[^/`\\s]+)/releases/download/(?<currentValue>[^/`\\s]+)/[^/`\\s@]+@sha256:(?<currentDigest>[0-9a-f]{64})`"
      ],
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "description": "RCP-30: the generators a recipe pins, as github>kadet-hub/renovate-config matches them in inventories",
      "customType": "regex",
      "managerFilePatterns": [
        "/^[^/]+/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "source:\\s*[\"']?(?<depName>ghcr\\.io/kadet-hub/[a-z][a-z0-9-]{1,38}):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9._-]{0,127})@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "RCP-29: the next pin follows the digest of the tag next, in one pull request updated at most once a day",
      "matchPackageNames": [
        "ghcr.io/kadet-hub/kapitan"
      ],
      "timezone": "Europe/Berlin",
      "schedule": [
        "* 0-5 * * *"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "RCP-16: mysql stays on MySQL's 9.7 LTS line; from 26.7 the Innovation releases use calendar versions",
      "matchPackageNames": [
        "container-registry.oracle.com/mysql/community-server"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "RCP-16: mongodb stays on MongoDB's 9.0 major release; minor releases are not patched once the next is out. Docker Hub gives no release timestamps for the image and MongoDB rebuilds the tag almost daily, so no release age and one window a week",
      "matchPackageNames": [
        "docker.io/mongodb/mongodb-community-server"
      ],
      "allowedVersions": "/^9\\.0\\./",
      "timezone": "Europe/Berlin",
      "schedule": [
        "* 0-5 * * 1"
      ],
      "updateNotScheduled": false,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "RCP-30: kind and the node image of its release",
      "matchDepNames": [
        "kubernetes-sigs/kind",
        "kindest/node"
      ],
      "groupName": "kind"
    },
    {
      "description": "Runners stay on ubuntu-24.04: actionlint 1.7.12 does not know newer labels",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    },
    {
      "description": "check's requires-python pins Python 3.13, the interpreter Kapitan 0.36.3 is used with",
      "matchManagers": [
        "pep621"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "check/.python-version stays on 3.13, which requires-python allows",
      "matchManagers": [
        "pyenv"
      ],
      "allowedVersions": "<3.14"
    },
    {
      "description": "Kapitan 0.36.3's omegaconf backend needs ListMergeMode, which later omegaconf releases removed (kapicorp/kapitan#1621)",
      "matchPackageNames": [
        "omegaconf"
      ],
      "allowedVersions": "/^2\\.4\\.0\\.dev4$/"
    },
    {
      "description": "Registries other than Docker Hub report no release timestamp",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^[^/]*[.:][^/]*//",
        "!/^(docker\\.io|index\\.docker\\.io)//"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
