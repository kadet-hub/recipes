#!/usr/bin/env bash
# RCP-363: the pods pass Pod Security restricted. Through the Service
# matrix-synapse the homeserver reports the image tag, serves no federation
# and refuses open registration. The admin of the Job matrix-synapse-admin
# logs in, creates a second user, a room and a message with an upload. The
# second user joins and reads both, also after the pod was replaced, with
# the same signing key. The login names the provider of the option oidc.
# Element Web answers through its Service, and its config.json names the
# homeserver, which answers at that URL.
set -euo pipefail
fail() { echo "$*" >&2; exit 1; }
kubectl wait clusters.postgresql.cnpg.io/postgresql-cluster --for=condition=Ready --timeout=600s >/dev/null
ns=$(kubectl config view --minify -o jsonpath='{..namespace}')
warnings=$(kubectl label --dry-run=server --overwrite namespace "$ns" \
  pod-security.kubernetes.io/enforce=restricted 2>&1 >/dev/null)
[[ -z $warnings ]] || fail "$warnings"
proxy() { kubectl get --raw "/api/v1/namespaces/$ns/services/matrix-synapse:8008/proxy$1"; }
tag=$(kubectl get statefulset matrix-synapse -o jsonpath='{.spec.template.spec.containers[0].image}' | sed 's/@.*//; s/.*://')
proxy /_synapse/admin/v1/server_version | jq -e --arg v "${tag#v}" '.server_version == $v' >/dev/null ||
  fail "Synapse does not report the version of the tag $tag"
proxy /_matrix/client/versions | jq -e '.versions | length > 0' >/dev/null

# The Job registers the admin once Synapse answers.
kubectl wait job/matrix-synapse-admin --for=condition=Complete --timeout=480s >/dev/null
server=$(sed -n 's/^server_name: //p' <(kubectl get configmap matrix-synapse -o jsonpath='{.data.homeserver\.yaml}'))
admin=$(kubectl get job matrix-synapse-admin -o json | jq -r '.spec.template.spec.containers[0].args as $a | $a[($a | index("--user")) + 1]')
password=$(kubectl get secret matrix-synapse -o jsonpath='{.data.admin-password}' | base64 -d)
reader=smoke-reader reader_password=cccccccccccccccc

url=http://localhost:18008
pf=
forward() {
  [[ -z $pf ]] || kill "$pf" 2>/dev/null || true
  kubectl port-forward service/matrix-synapse 18008:8008 >/dev/null &
  pf=$!
  for _ in $(seq 30); do
    curl -fsS -o /dev/null "$url/health" 2>/dev/null && return
    sleep 2
  done
  fail "no answer through the port forward"
}
trap '[[ -z $pf ]] || kill $pf' EXIT
forward
# Federation is off: the listener serves neither the federation API nor
# the server keys.
for path in /_matrix/federation/v1/version /_matrix/key/v2/server; do
  status=$(curl -sS -o /dev/null -w '%{http_code}' "$url$path")
  [[ $status == 404 ]] || fail "$path got $status, not 404"
done
login() {
  jq -n --arg u "$1" --arg p "$2" '{type: "m.login.password", identifier: {type: "m.id.user", user: $u}, password: $p}' |
    curl -fsS -H 'Content-Type: application/json' --data @- "$url/_matrix/client/v3/login" | jq -er .access_token
}
api() { local token=$1; shift; curl -fsS -H "Authorization: Bearer $token" -H 'Content-Type: application/json' "$@"; }

token=$(login "$admin" "$password") || fail "the admin cannot log in"
api "$token" "$url/_synapse/admin/v2/users/@$admin:$server" | jq -e '.admin == true' >/dev/null ||
  fail "$admin is no admin"
# The option oidc lists its provider for login.
curl -fsS "$url/_matrix/client/v3/login" |
  jq -e '[.flows[] | select(.type == "m.login.sso") | .identity_providers[] | select(.id == "oidc")] | length == 1' >/dev/null ||
  fail "the login flows name no provider oidc"
register=$(jq -n '{username: "intruder", password: "dddddddddddddddd", auth: {type: "m.login.dummy"}}')
status=$(curl -sS -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' --data "$register" "$url/_matrix/client/v3/register")
[[ $status == 403 ]] || fail "open registration got $status, not 403"

jq -n --arg p "$reader_password" '{password: $p, admin: false}' |
  api "$token" -X PUT --data @- "$url/_synapse/admin/v2/users/@$reader:$server" >/dev/null
room=$(jq -n --arg u "@$reader:$server" '{name: "smoke", preset: "private_chat", invite: [$u]}' |
  api "$token" --data @- "$url/_matrix/client/v3/createRoom" | jq -er .room_id)
content="smoke upload $RANDOM"
mxc=$(curl -fsS -H "Authorization: Bearer $token" -H 'Content-Type: text/plain' --data "$content" \
  "$url/_matrix/media/v3/upload?filename=smoke.txt" | jq -er .content_uri)
message="hello from $admin $RANDOM"
jq -n --arg m "$message" '{msgtype: "m.text", body: $m}' |
  api "$token" -X PUT --data @- "$url/_matrix/client/v3/rooms/$room/send/m.room.message/smoke-$RANDOM" >/dev/null

reader_token=$(login "$reader" "$reader_password") || fail "$reader cannot log in"
api "$reader_token" --data '{}' "$url/_matrix/client/v3/join/$room" >/dev/null
# The message from PostgreSQL, the upload from the claim.
read_back() {
  api "$reader_token" "$url/_matrix/client/v3/rooms/$room/messages?dir=b&limit=20" |
    jq -e --arg m "$message" '[.chunk[] | select(.content.body == $m)] | length == 1' >/dev/null ||
    fail "$reader does not read the message $1"
  [[ $(api "$reader_token" "$url/_matrix/client/v1/media/download/${mxc#mxc://}") == "$content" ]] ||
    fail "$reader does not read the upload $1"
}
read_back "after the post"
key() { kubectl exec matrix-synapse-0 -c matrix-synapse -- sha256sum /data/signing.key | cut -d' ' -f1; }
signing_key=$(key)

old=$(kubectl get pod matrix-synapse-0 -o jsonpath='{.metadata.uid}')
kubectl delete pod matrix-synapse-0 --wait=true >/dev/null
for _ in $(seq 60); do
  new=$(kubectl get pod matrix-synapse-0 -o jsonpath='{.metadata.uid}' 2>/dev/null || true)
  [[ $new && $new != "$old" ]] && kubectl wait pod/matrix-synapse-0 --for=condition=Ready --timeout=10s >/dev/null 2>&1 && break
  sleep 5
done
forward
read_back "after the pod was replaced"
[[ $(key) == "$signing_key" ]] || fail "the signing key changed with the pod"

# Element Web through its Service, and the homeserver at the URL it names.
web=http://matrix-synapse-element-web
in_pod() { kubectl exec matrix-synapse-0 -c matrix-synapse -- curl -fsS "$@"; }
in_pod "$web/" | grep -q '<title>Element' || fail "Element Web does not answer"
config=$(in_pod "$web/config.json")
base_url=$(jq -er '.default_server_config["m.homeserver"].base_url' <<<"$config")
jq -e --arg s "$server" '.default_server_config["m.homeserver"].server_name == $s' <<<"$config" >/dev/null ||
  fail "Element Web names another server than $server"
in_pod "${base_url%/}/_matrix/client/versions" | jq -e '.versions | length > 0' >/dev/null ||
  fail "no homeserver answers at $base_url"
echo "Synapse $tag on $server: $admin from the Job created $reader, a room and a message with an upload, which $reader read before and after the pod was replaced with the same signing key; registration got 403, federation 404; the login offers the provider oidc; Element Web points at $base_url; the pods pass Pod Security restricted"
